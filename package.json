{
  "name": "uncoverit-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && bun --bun next build",
    "dev": "bun --bun next dev",
    "start": "bunx serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-popover": "^1.1.23",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-openapi": "^11.2.4",
    "fumadocs-ui": "16.14.5",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
